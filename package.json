{
  "name": "adlens-platform",
  "private": true,
  "version": "1.0.0",
  "description": "投见 AdLens · 跨平台广告数据分析平台（纯前端 + Mock 数据，可打包 Windows 便携版桌面应用）",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=scripts/out/verify.mjs --alias:@=./src --log-level=warning && node scripts/out/verify.mjs",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --outfile=scripts/out/smoke.cjs --alias:@=./src --jsx=automatic --external:stream --log-level=warning && node scripts/out/smoke.cjs",
    "check": "npm run typecheck && npm run verify && npm run smoke"
  },
  "author": {
    "name": "adlens"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
