{
  "name": "video-device-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "视频设备云数据服务系统与技术服务 — 纯前端 Web 应用，全量 Mock 数据，无需后端；可通过 Electron 打包为桌面端",
  "author": "Video Cloud Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "electron:dev": "concurrently -k \"pnpm dev\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:start": "electron .",
    "pack:win": "vite build && electron-builder --win --x64",
    "pack:win:portable": "vite build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "file-saver": "^2.0.5",
    "lodash-es": "^4.17.21",
    "pinia": "^2.3.1",
    "vue": "^3.4.38",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "sass": "^1.79.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6",
    "wait-on": "^8.0.1"
  }
}
